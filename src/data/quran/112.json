[{"id":6222,"soorah":112,"ayah":1,"content":"Reci: 'On je Allah – Jedan!","content_latinized":"Reci: 'On je Allah – Jedan!","arabic":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ هُوَ اللَّهُ أَحَدٌ","transliteration":"Qul huwa Allahu ahad","juz":30},{"id":6223,"soorah":112,"ayah":2,"content":"Allah je Utočište svakom!","content_latinized":"Allah je Utociste svakom!","arabic":"اللَّهُ الصَّمَدُ","transliteration":"Allahu assamad","juz":30},{"id":6224,"soorah":112,"ayah":3,"content":"Nije rodio i rođen nije,","content_latinized":"Nije rodio i rođen nije,","arabic":"لَمْ يَلِدْ وَلَمْ يُولَدْ","transliteration":"Lam yalid walam yoolad","juz":30},{"id":6225,"soorah":112,"ayah":4,"content":"i niko Mu ravan nije!'","content_latinized":"i niko Mu ravan nije!'","arabic":"وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ","transliteration":"Walam yakun lahu kufuwan ahad","juz":30}]