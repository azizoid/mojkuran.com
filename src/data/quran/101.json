[{"id":6158,"soorah":101,"ayah":1,"content":"Smak svijeta!","content_latinized":"Smak svijeta!","arabic":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْقَارِعَةُ","transliteration":"AlqariAAa","juz":30},{"id":6159,"soorah":101,"ayah":2,"content":"Šta je Smak svijeta?","content_latinized":"Sta je Smak svijeta?","arabic":"مَا الْقَارِعَةُ","transliteration":"Ma alqariAAa","juz":30},{"id":6160,"soorah":101,"ayah":3,"content":"i šta ti znaš o Smaku svijeta?","content_latinized":"i sta ti znas o Smaku svijeta?","arabic":"وَمَا أَدْرَاكَ مَا الْقَارِعَةُ","transliteration":"Wama adraka ma alqariAAa","juz":30},{"id":6161,"soorah":101,"ayah":4,"content":"Toga dana će ljudi biti kao leptiri raštrkani,","content_latinized":"Toga dana ce ljudi biti kao leptiri rastrkani,","arabic":"يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ","transliteration":"Yawma yakoonu annasu kalfarashi almabthooth","juz":30},{"id":6162,"soorah":101,"ayah":5,"content":"a planine kao šarena vuna iščupanā.","content_latinized":"a planine kao sarena vuna iscupana.","arabic":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ","transliteration":"Watakoonu aljibalu kalAAihni almanfoosh","juz":30},{"id":6163,"soorah":101,"ayah":6,"content":"Onaj u koga njegova djela budu teška –","content_latinized":"Onaj u koga njegova djela budu teska –","arabic":"فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ","transliteration":"Faamma man thaqulat mawazeenuh","juz":30},{"id":6164,"soorah":101,"ayah":7,"content":"u ugodnu životu će živjeti,","content_latinized":"u ugodnu zivotu ce zivjeti,","arabic":"فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ","transliteration":"Fahuwa fee AAeeshatin radiya","juz":30},{"id":6165,"soorah":101,"ayah":8,"content":"a onaj u koga njegova djela budu lahka –","content_latinized":"a onaj u koga njegova djela budu lahka –","arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ","transliteration":"Waamma man khaffat mawazeenuh","juz":30},{"id":6166,"soorah":101,"ayah":9,"content":"boravište će mu bezdan biti.","content_latinized":"boravi